{
  "plugins": ["react", "import"],
  "rules": {
    "react/forbid-elements": ["warn", { "forbid": [] }],
    "no-restricted-imports": ["warn", {
      "patterns": [{
        "group": [
          "components/actions/UiButton/**",
          "components/feedback/UiError/**",
          "components/feedback/UiToast/**",
          "components/form/UiFormField/**",
          "components/form/UiInput/**",
          "components/form/UiSelect/**",
          "components/form/UiTextArea/**",
          "components/layout/UiPage/**",
          "components/layout/UiPopup/**",
          "components/typography/UiTitle/**",
          "components/wardrobe/ItemPickerSheet/**",
          "components/wardrobe/OutfitSuggestionCard/**"
        ],
        "message": "Import design-system components from 'index.js', not component internals."
      }]
    }],
    "no-restricted-syntax": ["warn",
      { "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]", "message": "Raw hex color — use a design-system color token via var()." },
      { "selector": "Literal[value=/\\b\\d+px\\b/]", "message": "Raw px value — use a design-system spacing token via var()." },
      { "selector": "JSXOpeningElement[name.name='ItemPickerSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|selectedIds|title|subtitle|confirmLabel|hideHeader|onSelectionChange|onConfirm|key|ref|className|style|children)$/]", "message": "<ItemPickerSheet> doesn't accept that prop. Declared props: items, selectedIds, title, subtitle, confirmLabel, hideHeader, onSelectionChange, onConfirm." },
      { "selector": "JSXOpeningElement[name.name='OutfitSuggestionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:suggestion|thumbnails|itemNames|onPress|onDelete|key|ref|className|style|children)$/]", "message": "<OutfitSuggestionCard> doesn't accept that prop. Declared props: suggestion, thumbnails, itemNames, onPress, onDelete." },
      { "selector": "JSXOpeningElement[name.name='UiButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onPress|secondary|enableLoader|style|key|ref|className|style|children)$/]", "message": "<UiButton> doesn't accept that prop. Declared props: children, onPress, secondary, enableLoader, style." },
      { "selector": "JSXOpeningElement[name.name='UiError'] > JSXAttribute > JSXIdentifier[name!=/^(?:errorMessage|key|ref|className|style|children)$/]", "message": "<UiError> doesn't accept that prop. Declared props: errorMessage." },
      { "selector": "JSXOpeningElement[name.name='UiFormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|errorMessage|key|ref|className|style|children)$/]", "message": "<UiFormField> doesn't accept that prop. Declared props: children, errorMessage." },
      { "selector": "JSXOpeningElement[name.name='UiInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|isSecureText|readonly|key|ref|className|style|children)$/]", "message": "<UiInput> doesn't accept that prop. Declared props: value, onChange, placeholder, isSecureText, readonly." },
      { "selector": "JSXOpeningElement[name.name='UiPage'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|indented|key|ref|className|style|children)$/]", "message": "<UiPage> doesn't accept that prop. Declared props: children, indented." },
      { "selector": "JSXOpeningElement[name.name='UiPopup'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|fullScreen|title|key|ref|className|style|children)$/]", "message": "<UiPopup> doesn't accept that prop. Declared props: children, fullScreen, title." },
      { "selector": "JSXOpeningElement[name.name='UiSelect'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|required|horizontal|key|ref|className|style|children)$/]", "message": "<UiSelect> doesn't accept that prop. Declared props: options, value, onChange, required, horizontal." },
      { "selector": "JSXOpeningElement[name.name='UiTextArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|numberOfLines|key|ref|className|style|children)$/]", "message": "<UiTextArea> doesn't accept that prop. Declared props: value, onChange, placeholder, numberOfLines." },
      { "selector": "JSXOpeningElement[name.name='UiTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|sizeXS|sizeS|sizeM|sizeL|style|numberOfLines|key|ref|className|style|children)$/]", "message": "<UiTitle> doesn't accept that prop. Declared props: children, sizeXS, sizeS, sizeM, sizeL, style, numberOfLines." },
      { "selector": "JSXOpeningElement[name.name='UiToast'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|ref|key|ref|className|style|children)$/]", "message": "<UiToast> doesn't accept that prop. Declared props: style, ref." }
    ]
  },
  "overrides": [{ "files": ["**/index.js"], "rules": { "no-restricted-imports": "off" } }],
  "x-omelette": {
    "components": {
      "ItemPickerSheet": { "replaces": [] }, "OutfitSuggestionCard": { "replaces": [] },
      "UiButton": { "replaces": [] }, "UiError": { "replaces": [] },
      "UiFormField": { "replaces": [] }, "UiInput": { "replaces": [] },
      "UiPage": { "replaces": [] }, "UiPopup": { "replaces": [] },
      "UiSelect": { "replaces": [] }, "UiTextArea": { "replaces": [] },
      "UiTitle": { "replaces": [] }, "UiToast": { "replaces": [] }
    },
    "tokens": ["--wa-accent","--wa-accent-text","--wa-background","--wa-border","--wa-error","--wa-error-background","--wa-page-inline-intent","--wa-placeholder","--wa-status-active","--wa-status-missing","--wa-status-need-repair","--wa-status-washing","--wa-surface","--wa-text-primary","--wa-text-secondary"],
    "tokenKinds": {
      "--wa-background": "color", "--wa-surface": "color", "--wa-text-primary": "font",
      "--wa-text-secondary": "font", "--wa-border": "color", "--wa-accent": "color",
      "--wa-accent-text": "font", "--wa-status-active": "color", "--wa-status-washing": "color",
      "--wa-status-missing": "color", "--wa-status-need-repair": "color", "--wa-error": "color",
      "--wa-error-background": "color", "--wa-placeholder": "color", "--wa-page-inline-intent": "spacing"
    },
    "fontFamilies": []
  }
}
